{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ez-order-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "EZ_ORDER_KV_CACHE",
      "id": "58b83993e3514b549c03d77cde2512bd"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ez-order",
      "database_id": "e75c3a4f-28c7-46dc-8005-55c88ae7977e"
    }
  ],
